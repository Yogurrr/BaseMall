# 💡 V10 마이그레이션(Row Level Security)부터는 두 계정을 분리해서 쓴다.
# - spring.datasource.* : Hibernate/Hikari가 실제 API 요청을 처리할 때 쓰는, RLS가 적용되는
#   제한된 런타임 전용 계정(app_runtime). 테이블 소유자가 아니라서 정책이 그대로 적용된다.
# - spring.flyway.* : 마이그레이션(DDL/GRANT/정책 생성)을 실행하는 기존 소유자 계정.
#   테이블 소유자는 RLS의 영향을 받지 않으므로 스키마 변경 권한을 그대로 유지해야 한다.
#
# 처음 설정할 때 순서:
#   1) 기존에 쓰던 소유자 계정 정보를 spring.flyway.user/password에 옮겨 적는다.
#   2) 앱을 한 번 띄워 V10 마이그레이션이 app_runtime 역할을 만들게 한다.
#   3) DB에 접속해서 직접 비밀번호를 설정한다: ALTER ROLE app_runtime WITH PASSWORD '...';
#   4) 그 비밀번호를 spring.datasource.password에 넣는다.
spring.datasource.url=jdbc:postgresql://<host>:5432/postgres
spring.datasource.username=app_runtime
spring.datasource.password=<app_runtime 비밀번호 - 위 3번 단계에서 직접 설정한 값>

spring.flyway.url=jdbc:postgresql://<host>:5432/postgres
spring.flyway.user=<기존에 쓰던 소유자 계정 username>
spring.flyway.password=<기존에 쓰던 소유자 계정 password>

# 💡 HS256 서명 키 (최소 256bit/32byte 필요)
jwt.secret=<random-32byte-hex-string>

# 💡 상품 이미지 업로드용 Supabase Storage 설정.
# Supabase 대시보드 > Storage에서 <bucket> 이름의 public 버킷을 먼저 만들고,
# Settings > API의 service_role 키를 <service-role-key>에 넣을 것 (프론트에는 절대 노출하지 않음).
supabase.storage.url=https://<project-ref>.supabase.co
supabase.storage.bucket=product-images
supabase.storage.service-role-key=<service-role-key>

# 💡 카카오페이 테스트 결제 연동. developers.kakao.com 콘솔 > 내 애플리케이션 > 카카오페이 탭에서
# 발급되는 시크릿 키(대문자+숫자 40자). 일반 "앱 키" 탭의 Admin key와는 다른 별도 키라 주의할 것.
# 사업자 등록 없이도 카카오가 제공하는 테스트 CID(TC0ONETIME, application.properties에 설정됨)로 결제 테스트가 가능하다.
kakaopay.secret-key=<카카오페이 탭에서 발급받은 시크릿 키>

# 💡 토스페이먼츠 테스트 결제 연동. 가입 없이도 토스 공식 문서에 공개된 테스트 시크릿 키로 결제 테스트가 가능하다.
# 실제 가맹점 계정을 만들면 developers.tosspayments.com 개발자센터 > 내 개발정보에서 발급받는 키로 교체할 것.
tosspayments.secret-key=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R

# 💡 카카오 로그인 + "나에게 보내기" 알림 연동. developers.kakao.com 콘솔 > 내 애플리케이션 >
# 앱 키의 REST API 키(카카오페이 시크릿 키와는 다른 키). 카카오 로그인 활성화, 동의항목에서
# 닉네임/카카오계정(이메일)/talk_message 설정(이메일은 "필수 동의"로 해야 자동 가입이 된다),
# Redirect URI에 아래 두 경로를 모두 등록해야 한다(로컬 기준):
#   http://localhost:5173/login/kakao/callback       (로그인 화면의 "카카오로 시작하기")
#   http://localhost:5173/mypage/kakao/callback       (마이페이지 > 회원정보수정의 계정 연동)
# 비워두면 카카오 로그인/연동 기능만 동작하지 않는다.
kakao.oauth.client-id=<카카오 디벨로퍼스에서 발급받은 REST API 키>
